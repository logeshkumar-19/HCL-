
import java.util.Scanner;

class Delivery {
    double orderAmount;

    Delivery(double orderAmount) {
        this.orderAmount = orderAmount;
    }

    double calculateDeliveryCharge() {
        return orderAmount;
    }
}

class RegularDelivery extends Delivery {

    RegularDelivery(double orderAmount) {
        super(orderAmount);
    }

    @Override
    double calculateDeliveryCharge() {
        return orderAmount + 40.0;
    }
}

class ExpressDelivery extends Delivery {

    ExpressDelivery(double orderAmount) {
        super(orderAmount);
    }

    @Override
    double calculateDeliveryCharge() {
        return orderAmount + 80.0 + (orderAmount * 5 / 100);
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int deliveryType = sc.nextInt();
        double orderAmount = sc.nextDouble();

        Delivery d;

        if (deliveryType == 1) {
            d = new RegularDelivery(orderAmount);
        }
        else {
            d = new ExpressDelivery(orderAmount);
        }

        double total = d.calculateDeliveryCharge();

        System.out.printf("%.2f%n", total);

        sc.close();
    }
}
