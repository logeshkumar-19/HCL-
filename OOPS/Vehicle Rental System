
import java.util.Scanner;

class Vehicle {
    double dailyRate;

    Vehicle(double dailyRate) {
        this.dailyRate = dailyRate;
    }

    double calculateRentalCharge(int rentalDays) {
        return dailyRate * rentalDays;
    }

    String getVehicleType() {
        return "Vehicle";
    }
}

class Car extends Vehicle {

    Car() {
        super(1500.0);
    }

    @Override
    String getVehicleType() {
        return "Car";
    }
}

class Bike extends Vehicle {

    Bike() {
        super(600.0);
    }

    @Override
    String getVehicleType() {
        return "Bike";
    }
}

class Truck extends Vehicle {

    Truck() {
        super(3000.0);
    }

    @Override
    String getVehicleType() {
        return "Truck";
    }
}

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int vehicleType = sc.nextInt();
        int rentalDays = sc.nextInt();

        Vehicle v;

        if (vehicleType == 1) {
            v = new Car();
        }
        else if (vehicleType == 2) {
            v = new Bike();
        }
        else {
            v = new Truck();
        }

        System.out.println("Vehicle Type: " + v.getVehicleType());

        double charge = v.calculateRentalCharge(rentalDays);

        System.out.printf("Rental Charge: %.2f%n", charge);

        sc.close();
    }
}
